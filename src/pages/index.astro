---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base>
  <h1>Issei Kuzuki</h1>
  <p class="muted">
    Data and platform engineering. Currently at Curve Analytics, building the
    agentic analytics layer.
  </p>

  <p>
    I work on the unglamorous parts of LLM-backed products: the data plane,
    the infrastructure, the cost engineering, the decisions that let a model
    call survive contact with production. Most of what I write here is
    fieldwork from those edges.
  </p>

  <p>
    The bigger personal project is
    <a href="https://fpl.isseikuzuki.co.uk/">FPL Pulse</a>, a weekly LLM
    enrichment pipeline plus an interactive transfer recommendation agent,
    both running end-to-end on AWS. The dashboard is live; the architecture
    and the decisions are in <a href="/projects/fpl-pulse/">the writeup</a>.
  </p>

  {
    posts.length > 0 && (
      <>
        <h2>Recent writing</h2>
        <ul class="post-list">
          {posts.map((p) => (
            <li>
              <time datetime={p.data.pubDate.toISOString()}>
                {p.data.pubDate.toLocaleDateString("en-GB", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
              <a href={`/writing/${p.slug}/`}>{p.data.title}</a>
            </li>
          ))}
        </ul>
        <p>
          <a href="/writing/">All posts →</a>
        </p>
      </>
    )
  }
</Base>
