<mxfile host="app.diagrams.net" modified="2026-05-21T00:00:00.000Z" agent="Claude" version="24.0.0">
  <diagram name="CloudFront shared-secret" id="cf-shared-secret">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title and subtitle -->
        <mxCell id="title" value="CloudFront shared-secret &#xb7; defence in depth for a public Function URL" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="1440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="OAC + AWS_IAM fails on streaming POST (SigV4 needs the body hash CloudFront can't compute in time)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;fontColor=#6B6358;" vertex="1" parent="1">
          <mxGeometry x="80" y="75" width="1440" height="24" as="geometry" />
        </mxCell>

        <!-- Browser (legitimate path) -->
        <mxCell id="browser" value="Browser&#xa;(dashboard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#6B6358;strokeWidth=2;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="80" y="210" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- CloudFront -->
        <mxCell id="cloudfront" value="CloudFront" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#5B21B6;verticalAlign=top;spacingTop=12;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="260" y="170" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cf-behavior" value="behaviour /api/agent/*&#xa;origin-request policy:&#xa;X-CloudFront-Secret&#xa;= ssm:cf_secret" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=ui-monospace, SF Mono, Menlo, monospace;fontColor=#5B21B6;spacingLeft=12;" vertex="1" parent="cloudfront">
          <mxGeometry x="10" y="35" width="220" height="115" as="geometry" />
        </mxCell>

        <!-- Function URL -->
        <mxCell id="function-url" value="Lambda Function URL&#xa;auth_type = NONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EC;strokeColor=#ED7100;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#A04A00;" vertex="1" parent="1">
          <mxGeometry x="530" y="220" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- Middleware decision -->
        <mxCell id="middleware" value="FastAPI middleware:&#xa;header matches?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7A5A1A;" vertex="1" parent="1">
          <mxGeometry x="760" y="200" width="180" height="110" as="geometry" />
        </mxCell>

        <!-- DDB budget + rate cap (new) -->
        <mxCell id="ddb-cap" value="DynamoDB budget &amp; rate cap:&#xa;under per-request budget?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7A5A1A;" vertex="1" parent="1">
          <mxGeometry x="980" y="200" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- Handler (Scout Agent) -->
        <mxCell id="handler" value="Scout Agent&#xa;(streams over SSE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="1240" y="225" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- 403 (rejection from middleware) -->
        <mxCell id="reject-403" value="403 Forbidden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7A2A1F;" vertex="1" parent="1">
          <mxGeometry x="780" y="380" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- 429 (rejection from DDB cap) -->
        <mxCell id="reject-429" value="429 Too Many Requests&#xa;or budget exceeded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7A2A1F;" vertex="1" parent="1">
          <mxGeometry x="1000" y="380" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Direct caller (bypass attempt) - moved down to avoid SSM overlap -->
        <mxCell id="attacker" value="Anyone hitting the&#xa;raw Function URL&#xa;directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B85450;strokeWidth=2;dashed=1;fontSize=12;fontStyle=2;fontColor=#7A2A1F;" vertex="1" parent="1">
          <mxGeometry x="80" y="570" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- SSM secret store -->
        <mxCell id="ssm" value="SSM SecureString&#xa;cf_secret" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FCEAF3;strokeColor=#B85450;strokeWidth=2;fontSize=11;fontColor=#7A2A1F;" vertex="1" parent="1">
          <mxGeometry x="370" y="430" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- DynamoDB table (the source for the budget cap) -->
        <mxCell id="ddb-table" value="DynamoDB&#xa;per-request budget&#xa;+ per-IP rate counter" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFF7EC;strokeColor=#ED7100;strokeWidth=2;fontSize=11;fontColor=#A04A00;" vertex="1" parent="1">
          <mxGeometry x="1010" y="490" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- Edges - legitimate path -->
        <mxCell id="e-browser-cf" value="https&#xa;/api/agent/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#8C4FFF;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontStyle=2;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="browser" target="cloudfront">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cf-furl" value="injects X-CloudFront-Secret" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#ED7100;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontStyle=1;fontColor=#A04A00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cloudfront" target="function-url">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-furl-mw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#A04A00;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="function-url" target="middleware">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-mw-ddb" value="header valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#2E7D32;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontStyle=2;fontColor=#1B5E20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="middleware" target="ddb-cap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ddb-handler" value="under budget" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#2E7D32;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontStyle=2;fontColor=#1B5E20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ddb-cap" target="handler">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Middleware -> 403: header missing or wrong -->
        <mxCell id="e-mw-403" value="missing or wrong" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;fontStyle=2;fontColor=#7A2A1F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="middleware" target="reject-403">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DDB cap -> 429: budget exceeded -->
        <mxCell id="e-ddb-429" value="cap exceeded" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;fontStyle=2;fontColor=#7A2A1F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ddb-cap" target="reject-429">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DDB cap reads DDB table -->
        <mxCell id="e-ddb-table" value="reads/writes counter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=classic;strokeColor=#ED7100;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontStyle=2;fontColor=#A04A00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ddb-cap" target="ddb-table">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SSM -> CloudFront: resolves at apply time -->
        <mxCell id="e-ssm-cf" value="resolves at apply" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;fontStyle=2;fontColor=#7A2A1F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ssm" target="cloudfront">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="350" />
              <mxPoint x="375" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- SSM -> Middleware: resolves at cold start (route around 403) -->
        <mxCell id="e-ssm-mw" value="resolves at cold start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;fontStyle=2;fontColor=#7A2A1F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ssm" target="middleware">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="470" />
              <mxPoint x="600" y="350" />
              <mxPoint x="850" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Attacker -> Function URL: routes around SSM -->
        <mxCell id="e-attacker-furl" value="no header" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#B85450;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=11;fontStyle=2;fontColor=#7A2A1F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="attacker" target="function-url">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="625" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Metrics strip -->
        <mxCell id="metrics-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#CCCCCC;" vertex="1" parent="1">
          <mxGeometry x="80" y="780" width="1440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="metrics" value="Two layers of defence in depth: shared-secret header at the edge, DynamoDB budget + rate cap at the runtime" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="80" y="780" width="1440" height="50" as="geometry" />
        </mxCell>

